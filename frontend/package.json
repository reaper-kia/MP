{
  "name": "mp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mocks": "vite --mode mocks",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../contracts/http/openapi.yaml -o src/api/schema.d.ts",
    "mock": "prism mock ../contracts/http/openapi.yaml -p 4010",
    "build:ext": "vite build -c vite.extension.config.ts --mode extension",
    "zip:ext": "node scripts/zip-ext.mjs"
  },
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/dates": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@tanstack/react-query": "^5.104.4",
    "dayjs": "^1.11.23",
    "openapi-fetch": "^0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.14.2",
    "@types/chrome": "^0.1.43",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.31",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
