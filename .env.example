# Скопируй в .env (make env). На сервере .env генерирует Ansible (infra/ansible/roles/env).
# Это переменные для docker compose. У каждого сервиса для локального запуска
# свой services/<сервис>/.env.example.

SEARCH_DB_PASSWORD=search_local

# true — collector отдаёт тестовые посты [FAKE] (разработка). На демо — false!
COLLECTOR_FAKE=true

# Доступы к площадкам (B1). VK: либо сервисный ключ (нужна верификация бизнеса), либо вход
# обычным аккаунтом — python3 scripts/vk_token.py пишет .vk/token.json, сборщик сам его обновляет.
# Yandex Search API (необязательно, платно) — поиск по всей площадке VK и OK (site:vk.com, site:ok.ru).
# Без ключа «Везде» — все активные источники каталога
VK_SERVICE_TOKEN=
YC_SEARCH_API_KEY=
# MAX: токен бота (business.max.ru); бот должен быть администратором собираемых каналов.
# Если TLS к MAX не проходит — PEM Минцифры в infra/certs/ и HTTP_CA_BUNDLE=/certs/<файл>.pem
MAX_BOT_TOKEN=
# MAX_API_URL=https://platform-api2.max.ru
HTTP_CA_BUNDLE=

# Yandex Cloud: YC_API_KEY — API-ключ сервисного аккаунта с ролью ai.languageModels.user (LLM_PROVIDER=yandex)
YC_FOLDER_ID=
YC_API_KEY=

# Модели ml_service — ОДИН ПЕРЕКЛЮЧАТЕЛЬ, после смены: docker compose up -d ml_service
#   LLM_PROVIDER=yandex — всё через Yandex AI Studio (нужны YC_FOLDER_ID и YC_API_KEY выше)
#   LLM_PROVIDER=ollama — всё через локальные модели (Ollama, OLLAMA_URL ниже)
#   LLM_PROVIDER=stub   — без моделей, эвристики
#   LLM_PROVIDER=ollama,yandex — цепочка по порядку: Ollama, не отвечает — Яндекс, потом эвристики
#                                (так на сервере: Ollama ноута через SSH-туннель, ML-15)
# EMBED_PROVIDER — пусто = как LLM_PROVIDER; задавать, только чтобы развести LLM и эмбеддинги
LLM_PROVIDER=stub
EMBED_PROVIDER=
# Ollama на хосте (ноут): из контейнера — host.docker.internal
# OLLAMA_URL=http://host.docker.internal:11434
# false — не показывать «ML работал в упрощённом режиме» (эвристики). На демо — true
# ML_SHOW_DEGRADED_WARNING=true
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
# пусто — судья ScorePosts на той же модели; не укладывается в 60 с на батч — qwen2.5:3b-instruct
OLLAMA_JUDGE_MODEL=
OLLAMA_EMBED_MODEL=bge-m3

# Кэш в Redis (B2-20). После смены: docker compose up -d search_service collector_service
# Сбросить кэш: make cache-flush
# false — кэш выключен целиком, всё работает как раньше
CACHE_ENABLED=true
REDIS_URL=redis://redis:6379/0
# готовая подборка: тот же поиск в течение 30 минут — сразу копия
CACHE_SEARCH_TTL_SECONDS=1800
# посты источника / поиск по площадке: похожий поиск по тем же источникам не выкачивает стены заново
CACHE_COLLECT_TTL_SECONDS=600
# карточка источника по ссылке
CACHE_RESOLVE_TTL_SECONDS=600
# потолок памяти Redis (сервер — 3.8 ГБ всего); после смены: docker compose up -d redis
REDIS_MAXMEMORY=256mb

# Порт фронта на хосте
HTTP_PORT=80
