# Скопируй в .env (make env). На сервере .env генерирует Ansible (infra/ansible/roles/env).
# Это переменные для docker compose. У каждого сервиса для локального запуска
# свой services/<сервис>/.env.example.

SEARCH_DB_PASSWORD=search_local

# true — collector отдаёт тестовые посты [FAKE] (разработка). На демо — false!
COLLECTOR_FAKE=true

# Доступы к площадкам (B1). VK: либо сервисный ключ (нужна верификация бизнеса), либо вход
# обычным аккаунтом — python3 scripts/vk_token.py пишет .vk/token.json, сборщик сам его обновляет.
# Yandex Search API — глобальный поиск OK/MAX, а для токена VK ID — и по VK (site:vk.com)
VK_SERVICE_TOKEN=
YC_SEARCH_API_KEY=

# Yandex Cloud (провайдер ML yandex не реализован — команда работает на локальных моделях)
YC_FOLDER_ID=
YC_API_KEY=

# Модели ml_service: stub — эвристики (degraded); ollama — локальные модели
# (docker compose --profile llm-local up -d ollama; модели скачать — см. services/ml_service/README.md)
LLM_PROVIDER=stub
EMBED_PROVIDER=stub
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
# пусто — судья ScorePosts на той же модели; не укладывается в 60 с на батч — qwen2.5:3b-instruct
OLLAMA_JUDGE_MODEL=
OLLAMA_EMBED_MODEL=bge-m3

# Порт фронта на хосте
HTTP_PORT=80
