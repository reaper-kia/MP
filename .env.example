# Скопируй в .env (make env). На сервере .env генерирует Ansible.
# Это переменные для docker compose. У каждого сервиса для локального запуска
# свой services/<сервис>/.env.example.

# Общий секрет JWT: auth_service подписывает, gateway проверяет (>= 32 символов)
JWT_SECRET=dev-secret-change-me-it-must-be-at-least-32-bytes

# Эти email при регистрации получают роль admin (через запятую)
ADMIN_EMAILS=admin@example.com

AUTH_DB_PASSWORD=auth_local
EXAMPLE_DB_PASSWORD=example_local

# true только при HTTPS, иначе браузер не сохранит refresh-cookie
COOKIE_SECURE=false

# Порт фронта на хосте
HTTP_PORT=80
