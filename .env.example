# Скопируй в .env (make install/make up сделают это сами). На сервере .env генерирует Ansible.
# Этот же файл читают сервисы при локальном запуске (make run s=...).

# Пароль единственного Postgres (у каждого сервиса своя БД внутри него)
POSTGRES_PASSWORD=app

# Секрет подписи access-токенов (>= 32 символов). Auth подписывает, Gateway проверяет.
JWT_SECRET=dev-secret-change-me-it-must-be-at-least-32-bytes

# Эти email при регистрации получают роль admin (через запятую)
ADMIN_EMAILS=admin@example.com

# Kafka: false — сервисы Kafka не трогают, события копятся в outbox-таблицах.
# make up-kafka поднимает профиль kafka и сам ставит true.
KAFKA_ENABLED=false

LOG_LEVEL=INFO

# true только при HTTPS, иначе браузер не сохранит refresh-cookie
COOKIE_SECURE=false

# Порты на хосте — поменяй, если заняты
HTTP_PORT=80
GATEWAY_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
# если поменял REDIS_PORT и запускаешь сервисы локально:
# REDIS_URL=redis://localhost:6379/0
