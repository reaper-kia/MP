# Скопируй в .env (make env). На сервере .env генерирует Ansible (infra/ansible/roles/env).
# Это переменные для docker compose. У каждого сервиса для локального запуска
# свой services/<сервис>/.env.example.

SEARCH_DB_PASSWORD=search_local

# true — collector отдаёт тестовые посты [FAKE] (разработка). На демо — false!
COLLECTOR_FAKE=true

# Доступы к площадкам (B1): сервисный ключ VK ID; Yandex Search API — глобальный поиск OK/MAX
VK_SERVICE_TOKEN=
YC_SEARCH_API_KEY=

# Yandex Cloud: каталог и API-ключ для YandexGPT и эмбеддингов (ML)
YC_FOLDER_ID=
YC_API_KEY=

# stub | ollama | yandex — какие модели использует ml_service
LLM_PROVIDER=stub
EMBED_PROVIDER=stub

# Порт фронта на хосте
HTTP_PORT=80
