# Для локального запуска (make run s=collector_service). В Docker значения задаёт compose.yaml.
GRPC_ADDRESS=[::]:50054
# true — вместо площадок отдаются тестовые посты с пометкой [FAKE] (только для разработки!)
COLLECTOR_FAKE=true
# Сервисный ключ приложения VK ID — или файл токена VK ID (scripts/vk_token.py, обновляется сам)
VK_SERVICE_TOKEN=
# VK_TOKEN_FILE=../../.vk/token.json
# Yandex Search API (глобальный поиск OK / MAX / сайтов)
YC_FOLDER_ID=
YC_SEARCH_API_KEY=
# MAX Bot API: токен бота; бот — администратор каналов. Для TLS к MAX может понадобиться
# корневой сертификат Минцифры: HTTP_CA_BUNDLE=../../infra/certs/<файл>.pem
MAX_BOT_TOKEN=
# MAX_API_URL=https://platform-api2.max.ru
# HTTP_CA_BUNDLE=
# Кэш сбора в Redis (B2-20). Порт Redis из compose наружу не открыт — локально выключен
# (карточки источников тогда кэшируются в памяти процесса, как раньше)
CACHE_ENABLED=false
# REDIS_URL=redis://localhost:6379/0
# CACHE_COLLECT_TTL_SECONDS=600
# CACHE_RESOLVE_TTL_SECONDS=600
