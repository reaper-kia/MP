# Для локального запуска (make run s=collector_service). В Docker значения задаёт compose.yaml.
GRPC_ADDRESS=[::]:50054
# true — вместо площадок отдаются тестовые посты с пометкой [FAKE] (только для разработки!)
COLLECTOR_FAKE=true
# Сервисный ключ приложения VK ID
VK_SERVICE_TOKEN=
# Yandex Search API (глобальный поиск OK / MAX / сайтов)
YC_FOLDER_ID=
YC_SEARCH_API_KEY=
