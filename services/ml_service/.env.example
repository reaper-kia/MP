# Для локального запуска (make run s=ml_service). В Docker значения задаёт compose.yaml.
GRPC_ADDRESS=[::]:50055
# stub — эвристики, ответы degraded=true; ollama — локальные модели (основной режим);
# yandex — Yandex AI Studio (YC_FOLDER_ID, YC_API_KEY); цепочка: ollama,yandex — по порядку.
# EMBED_PROVIDER пусто — та же цепочка, что LLM_PROVIDER
LLM_PROVIDER=stub
EMBED_PROVIDER=stub

# Ollama: ollama serve (или docker compose --profile llm-local up -d ollama), затем
#   ollama pull qwen2.5:7b-instruct && ollama pull bge-m3
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:7b-instruct
# судья ScorePosts; пусто — та же модель. Медленно (батч 30 постов > 60 с) — qwen2.5:3b-instruct
OLLAMA_JUDGE_MODEL=
OLLAMA_EMBED_MODEL=bge-m3
OLLAMA_KEEP_ALIVE=30m
# ноут через туннель: подключение не дольше (с); молчала дольше — сначала GET /api/version
OLLAMA_CONNECT_TIMEOUT_SECONDS=3
OLLAMA_PROBE_AFTER_SECONDS=20
# HTTP /health (какой провайдер отвечает); пусто — выключен
HEALTH_ADDRESS=127.0.0.1:8085

# Бюджеты RPC (меньше таймаутов search_service: 25 / 60 / 60 с) и судья
ANALYZE_BUDGET_SECONDS=20
SCORE_BUDGET_SECONDS=45
GROUP_BUDGET_SECONDS=40
JUDGE_BATCH_SIZE=6
JUDGE_CONCURRENCY=2
