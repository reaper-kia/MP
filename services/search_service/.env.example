# Для локального запуска (make run s=search_service). В Docker значения задаёт compose.yaml.
DATABASE_URL=postgresql+asyncpg://search:search_local@localhost:5435/search
GRPC_ADDRESS=[::]:50053
COLLECTOR_GRPC_TARGET=localhost:50054
ML_GRPC_TARGET=localhost:50055
# grpc (по умолчанию) — настоящие collector_service / ml_service;
# stub — офлайн без соседей (посты-фикстуры, оценки-заглушки; поиск получает warning «имитация»)
COLLECTOR_MODE=grpc
ML_MODE=grpc
# Кэш готовых подборок в Redis (B2-20). Порт Redis из compose наружу не открыт — локально выключен
CACHE_ENABLED=false
# REDIS_URL=redis://localhost:6379/0
# CACHE_SEARCH_TTL_SECONDS=1800
