# Сгенерировано Ansible. Секреты — из infra/ansible/.secrets на машине, с которой деплоили.
JWT_SECRET={{ lookup('ansible.builtin.password', secrets_dir + '/jwt_secret', length=64, chars=['ascii_letters', 'digits']) }}
AUTH_DB_PASSWORD={{ lookup('ansible.builtin.password', secrets_dir + '/auth_db_password', length=32, chars=['ascii_letters', 'digits']) }}
EXAMPLE_DB_PASSWORD={{ lookup('ansible.builtin.password', secrets_dir + '/example_db_password', length=32, chars=['ascii_letters', 'digits']) }}
ADMIN_EMAILS={{ admin_emails }}
COOKIE_SECURE={{ cookie_secure | string | lower }}
HTTP_PORT={{ http_port }}
