# Сгенерировано Ansible. Пароль БД — из infra/ansible/.secrets на машине, с которой деплоили.
# Ключи API берутся из окружения машины, с которой запускаешь деплой:
#   VK_SERVICE_TOKEN=... YC_FOLDER_ID=... YC_API_KEY=... YC_SEARCH_API_KEY=... MAX_BOT_TOKEN=... make deploy HOST=...
SEARCH_DB_PASSWORD={{ lookup('ansible.builtin.password', secrets_dir + '/search_db_password', length=32, chars=['ascii_letters', 'digits']) }}
COLLECTOR_FAKE={{ collector_fake | string | lower }}
VK_SERVICE_TOKEN={{ lookup('ansible.builtin.env', 'VK_SERVICE_TOKEN') }}
YC_SEARCH_API_KEY={{ lookup('ansible.builtin.env', 'YC_SEARCH_API_KEY') }}
YC_FOLDER_ID={{ lookup('ansible.builtin.env', 'YC_FOLDER_ID') }}
YC_API_KEY={{ lookup('ansible.builtin.env', 'YC_API_KEY') }}
MAX_BOT_TOKEN={{ lookup('ansible.builtin.env', 'MAX_BOT_TOKEN') }}
MAX_API_URL={{ lookup('ansible.builtin.env', 'MAX_API_URL') | default('https://platform-api2.max.ru', true) }}
HTTP_CA_BUNDLE={{ lookup('ansible.builtin.env', 'HTTP_CA_BUNDLE') }}
{% if lookup('ansible.builtin.env', 'NEWS_SITES') %}
NEWS_SITES='{{ lookup('ansible.builtin.env', 'NEWS_SITES') }}'
{% endif %}
# Модели (ML-15): цепочка через запятую, по порядку — ollama (ноут через туннель), yandex, эвристики
LLM_PROVIDER={{ lookup('ansible.builtin.env', 'LLM_PROVIDER') | default(llm_provider, true) }}
# пусто — как LLM_PROVIDER
EMBED_PROVIDER={{ lookup('ansible.builtin.env', 'EMBED_PROVIDER') | default(embed_provider, true) }}
OLLAMA_URL={{ lookup('ansible.builtin.env', 'OLLAMA_URL') | default(ollama_url, true) }}
OLLAMA_CONNECT_TIMEOUT_SECONDS={{ ollama_connect_timeout_seconds }}
ML_SHOW_DEGRADED_WARNING={{ ml_show_degraded_warning | string | lower }}
HTTP_PORT={{ http_port }}
